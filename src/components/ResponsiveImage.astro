---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes = '(min-width: 56rem) 50vw, 100vw',
  class: className,
} = Astro.props;

const targetWidths = [360, 640, 960, 1280, 1600];
const maximumWidth = Math.min(src.width, 2000);
const widths = targetWidths.filter((width) => width < maximumWidth);
widths.push(maximumWidth);
---

<span class:list={['responsive-image', className]}>
  {src.format === 'svg' ? (
    <Image
      src={src}
      alt={alt}
      format="svg"
      loading={loading}
      fetchpriority={fetchpriority}
    />
  ) : (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[...new Set(widths)].sort((left, right) => left - right)}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  )}
</span>
