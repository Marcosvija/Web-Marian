---
interface Props {
  email?: string;
  phone?: string;
}

const { email, phone } = Astro.props;
---

<section class="contact-view sheet album-spread" aria-labelledby="contact-title" data-album-spread>
  <div class="album-page album-page-left">
    <header class="section-heading">
      <p class="eyebrow">Cierre</p>
      <h1 id="contact-title">Contacto</h1>
    </header>
  </div>

  <div class="album-page album-page-right">
    {(email || phone) ? (
      <ul class="contact-list">
        {email && <li><a href={`mailto:${email}`}>Correo electrónico</a></li>}
        {phone && <li><a href={`tel:${phone}`}>Teléfono</a></li>}
      </ul>
    ) : (
      <p class="empty-state" role="status">Canal de contacto pendiente de contenido.</p>
    )}

  </div>
</section>
