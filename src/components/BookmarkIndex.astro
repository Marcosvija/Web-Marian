---
import type { NavigationItem } from '../lib/navigation';

interface Props {
  items: NavigationItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;
const normalizePath = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const activePath = normalizePath(currentPath);
---

<details class="bookmark-index" data-bookmark-index>
  <summary>
    <span class="bookmark-ribbon-label">Índice</span>
  </summary>
  <nav class="bookmark-panel" aria-label="Índice del álbum">
    <p class="bookmark-heading">Atrapando instantes</p>
    <ul>
      {items.map((item) => {
        const isCurrent = activePath === normalizePath(item.href);
        const isCover = item.kind === 'cover' || item.kind === 'back-cover';
        return (
          <li
            data-bookmark-kind={item.kind}
            class:list={[
              {
                'is-category': item.kind === 'category',
                'is-cover-destination': isCover,
              },
            ]}
          >
            <a href={item.href} aria-current={isCurrent ? 'page' : undefined}>
              <span>{item.label}</span>
              {isCurrent && <span class="current-marker">Actual</span>}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</details>

<script>
  const bookmark = document.querySelector<HTMLDetailsElement>('[data-bookmark-index]');

  const updateBookmarkViewportGeometry = () => {
    if (!bookmark) return;

    const albumObject = bookmark.closest<HTMLElement>('[data-album-object]');
    const top = albumObject?.getBoundingClientRect().top ?? bookmark.getBoundingClientRect().top;
    const viewportGap = 8;
    const desiredLift = 32;
    const lift = Math.max(0, Math.min(desiredLift, top - viewportGap));
    const remainingHeadroom = Math.max(0, top - lift - viewportGap);

    bookmark.style.setProperty('--bookmark-lift', `${lift}px`);
    bookmark.style.setProperty('--bookmark-hover-pull', `${Math.min(6, remainingHeadroom)}px`);
    bookmark.style.setProperty('--bookmark-open-pull', `${Math.min(24, remainingHeadroom)}px`);
    bookmark.style.setProperty(
      '--bookmark-panel-viewport-top',
      `${Math.max(viewportGap, top + 14)}px`,
    );
    bookmark.dataset.bookmarkViewportReady = 'true';
  };

  bookmark?.addEventListener('toggle', () => requestAnimationFrame(updateBookmarkViewportGeometry));
  window.addEventListener('resize', updateBookmarkViewportGeometry);
  window.visualViewport?.addEventListener('resize', updateBookmarkViewportGeometry);
  requestAnimationFrame(updateBookmarkViewportGeometry);
</script>
