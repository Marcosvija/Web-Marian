---
import AlbumMapList from './AlbumMapList.astro';
import type { AlbumDestination } from '../lib/album-map';

interface Props {
  items: AlbumDestination[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;
---

<details class="bookmark-index" data-bookmark-index data-bookmark-side={currentPath === '/contraportada/' ? 'left' : 'right'} data-bookmark-viewport-ready="true">
  <summary>
    <span class="bookmark-ribbon"><span class="bookmark-ribbon-label">Índice</span></span>
  </summary>
  <nav class="bookmark-panel" aria-label="Índice del álbum" data-album-map-view="bookmark">
    <p class="bookmark-heading">Atrapando instantes</p>
    <AlbumMapList items={items} currentPath={currentPath} ariaLabel="Mapa completo del álbum" />
  </nav>
</details>

<script>
  const bookmark = document.querySelector<HTMLDetailsElement>('[data-bookmark-index]');

  bookmark?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !bookmark.open) return;
    event.preventDefault();
    bookmark.open = false;
    bookmark.querySelector('summary')?.focus();
  });
  document.addEventListener('pointerdown', (event) => {
    if (bookmark?.open && event.target instanceof Node && !bookmark.contains(event.target)) {
      bookmark.open = false;
    }
  });
</script>
