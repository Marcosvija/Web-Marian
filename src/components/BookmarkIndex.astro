---
import AlbumMapList from './AlbumMapList.astro';
import type { AlbumDestination } from '../lib/album-map';

interface Props {
  items: AlbumDestination[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;
---

<details class="bookmark-index" data-bookmark-index>
  <summary>
    <span class="bookmark-ribbon"><span class="bookmark-ribbon-label">Índice</span></span>
  </summary>
  <nav class="bookmark-panel" aria-label="Índice del álbum" data-album-map-view="bookmark">
    <p class="bookmark-heading">Atrapando instantes</p>
    <AlbumMapList items={items} currentPath={currentPath} ariaLabel="Mapa completo del álbum" />
  </nav>
</details>

<script>
  const bookmark = document.querySelector<HTMLDetailsElement>('[data-bookmark-index]');

  const updateBookmarkViewportGeometry = () => {
    if (!bookmark) return;

    const albumObject = bookmark.closest<HTMLElement>('[data-album-object]');
    if (!albumObject) return;

    const objectBox = albumObject.getBoundingClientRect();
    const viewportWidth = window.visualViewport?.width ?? window.innerWidth;
    const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
    const leftSide = albumObject.classList.contains('is-back-cover-object');
    const sideSpace = leftSide ? objectBox.left : viewportWidth - objectBox.right;
    const viewportGap = 8;
    const desiredExposed = 24;
    const availableOutside = Math.max(0, sideSpace - viewportGap);
    const exposed = Math.min(desiredExposed, availableOutside);
    const remainingOutside = Math.max(0, availableOutside - exposed);
    const anchorTop = objectBox.top + objectBox.height * 0.4;
    const panelMaxHeight = Math.max(160, viewportHeight - anchorTop - 10);

    const direction = leftSide ? -1 : 1;
    const bookmarkBox = bookmark.getBoundingClientRect();
    const anchorX = leftSide ? bookmarkBox.left : bookmarkBox.right;
    const objectEdgeX = leftSide ? objectBox.left : objectBox.right;
    const edgeCorrection = objectEdgeX - anchorX;
    const hoverPull = Math.min(6, remainingOutside);
    const openPull = Math.min(16, remainingOutside);

    bookmark.style.setProperty('--bookmark-rest-x', `${edgeCorrection + direction * exposed}px`);
    bookmark.style.setProperty('--bookmark-hover-x', `${edgeCorrection + direction * (exposed + hoverPull)}px`);
    bookmark.style.setProperty('--bookmark-open-x', `${edgeCorrection + direction * (exposed + openPull)}px`);
    bookmark.style.setProperty('--bookmark-panel-max-height', `${panelMaxHeight}px`);
    bookmark.dataset.bookmarkSide = leftSide ? 'left' : 'right';
    // Commit the initial side and position before enabling extraction transitions.
    // Otherwise the back ribbon animates across the book edge on first load.
    if (!bookmark.dataset.bookmarkViewportReady) {
      bookmark.querySelector('summary')?.getBoundingClientRect();
    }
    bookmark.dataset.bookmarkViewportReady = 'true';
  };

  bookmark?.addEventListener('toggle', () => requestAnimationFrame(updateBookmarkViewportGeometry));
  bookmark?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !bookmark.open) return;
    event.preventDefault();
    bookmark.open = false;
    bookmark.querySelector('summary')?.focus();
  });
  document.addEventListener('pointerdown', (event) => {
    if (bookmark?.open && event.target instanceof Node && !bookmark.contains(event.target)) {
      bookmark.open = false;
    }
  });
  window.addEventListener('resize', updateBookmarkViewportGeometry);
  window.visualViewport?.addEventListener('resize', updateBookmarkViewportGeometry);
  requestAnimationFrame(updateBookmarkViewportGeometry);
</script>
