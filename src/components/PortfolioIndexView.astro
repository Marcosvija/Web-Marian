---
import AlbumMapList from './AlbumMapList.astro';
import type { AlbumDestination } from '../lib/album-map';

interface Props {
  items: AlbumDestination[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

const groups: AlbumDestination[][] = [];
for (const item of items) {
  const previousGroup = groups.at(-1);
  const previous = previousGroup?.[0];
  if (
    item.kind === 'category' &&
    item.categorySlug &&
    previous?.kind === 'category' &&
    previous.categorySlug === item.categorySlug
  ) {
    previousGroup?.push(item);
  } else {
    groups.push([item]);
  }
}

let splitIndex = 1;
let runningCount = 0;
let bestDistance = Number.POSITIVE_INFINITY;
for (let index = 0; index < groups.length - 1; index += 1) {
  runningCount += groups[index]?.length ?? 0;
  const distance = Math.abs(items.length / 2 - runningCount);
  if (distance < bestDistance) {
    bestDistance = distance;
    splitIndex = index + 1;
  }
}

const leftItems = groups.slice(0, splitIndex).flat();
const rightItems = groups.slice(splitIndex).flat();
---

<section
  class="portfolio-index sheet album-spread"
  aria-labelledby="portfolio-title"
  data-album-spread
  data-album-map-view="index"
>
  <div class="album-page album-page-left">
    <header class="section-heading">
      <p class="eyebrow">Índice</p>
      <h1 id="portfolio-title">Atrapando instantes</h1>
    </header>
    <AlbumMapList items={leftItems} currentPath={currentPath} ariaLabel="Primera parte del mapa del álbum" showCategoryNumbers />
  </div>

  <div class="album-page album-page-right">
    <AlbumMapList items={rightItems} currentPath={currentPath} ariaLabel="Segunda parte del mapa del álbum" showCategoryNumbers />
  </div>
</section>
