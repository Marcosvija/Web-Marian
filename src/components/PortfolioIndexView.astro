---
import AlbumMapList from './AlbumMapList.astro';
import type { AlbumDestination } from '../lib/album-map';

interface Props {
  items: AlbumDestination[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

const groups: AlbumDestination[][] = [];
for (const item of items) {
  const previousGroup = groups.at(-1);
  const previous = previousGroup?.[0];
  if (
    item.kind === 'category' &&
    item.categorySlug &&
    previous?.kind === 'category' &&
    previous.categorySlug === item.categorySlug
  ) {
    previousGroup?.push(item);
  } else {
    groups.push([item]);
  }
}

---

<section
  class="portfolio-index sheet album-spread"
  aria-labelledby="portfolio-title"
  data-album-spread
  data-album-map-view="index"
  data-index-layout="flow"
>
  <div class="album-page album-page-left">
    <header class="section-heading">
      <p class="eyebrow">Índice</p>
      <h1 id="portfolio-title">Atrapando instantes</h1>
    </header>
    <div class="index-groups" data-index-groups>
      {groups.map((group) => (
        <div class="index-group" data-index-group>
          <AlbumMapList items={group} currentPath={currentPath} ariaLabel={group[0]?.label ?? 'Mapa del álbum'} showCategoryNumbers />
        </div>
      ))}
    </div>
  </div>

  <div class="album-page album-page-right">
    <div class="index-groups" data-index-groups></div>
  </div>
</section>

<script is:inline>
  // Synchronous layout after this section is parsed, before its first paint.
  document.dispatchEvent(new CustomEvent('album:compose-index', {
    detail: document.currentScript.previousElementSibling,
  }));
</script>
