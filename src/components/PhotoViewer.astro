---
import type { CategoryPhotoLocation } from '../lib/category-layout';

interface Props {
  photos: CategoryPhotoLocation[];
}
const { photos } = Astro.props;
---

<dialog class="photo-viewer" data-photo-viewer data-photo-locations={JSON.stringify(photos)} aria-labelledby="photo-viewer-title">
  <div class="viewer-surface">
    <h2 id="photo-viewer-title" class="visually-hidden">Visor de fotografías</h2>
    <form method="dialog" class="viewer-close-form">
      <button class="viewer-control viewer-close" value="close" aria-label="Cerrar visor">
        <span aria-hidden="true">×</span>
      </button>
    </form>

    <button class="viewer-control viewer-previous" type="button" data-viewer-previous aria-label="Fotografía anterior">
      <span aria-hidden="true">←</span>
    </button>

    <img class="viewer-image" data-viewer-image alt="" style="touch-action: pan-y;" />

    <button class="viewer-control viewer-next" type="button" data-viewer-next aria-label="Fotografía siguiente">
      <span aria-hidden="true">→</span>
    </button>

    <p class="visually-hidden" aria-live="polite" data-viewer-status></p>
  </div>
</dialog>

<script>
  import type { CategoryPhotoLocation } from '../lib/category-layout';

  const viewer = document.querySelector<HTMLDialogElement>('[data-photo-viewer]');
  const triggers = [...document.querySelectorAll<HTMLAnchorElement>('[data-photo-trigger]')];

  if (viewer && triggers.length > 0 && typeof viewer.showModal === 'function') {
    const photos: CategoryPhotoLocation[] = JSON.parse(viewer.dataset.photoLocations ?? '[]');
    const localTriggers = new Map(triggers.map((trigger) => [trigger.dataset.photoId, trigger]));
    const image = viewer.querySelector<HTMLImageElement>('[data-viewer-image]');
    const status = viewer.querySelector<HTMLElement>('[data-viewer-status]');
    const previous = viewer.querySelector<HTMLButtonElement>('[data-viewer-previous]');
    const next = viewer.querySelector<HTMLButtonElement>('[data-viewer-next]');
    const close = viewer.querySelector<HTMLButtonElement>('.viewer-close');
    let currentIndex = 0;
    let opener: HTMLAnchorElement | null = null;
    let activePointerId: number | null = null;
    let pointerStartX: number | null = null;
    let navigating = false;

    const updateUrl = (photoId?: string) => {
      const url = new URL(window.location.href);
      if (photoId) {
        url.searchParams.set('foto', photoId);
        url.hash = '';
      } else {
        url.searchParams.delete('foto');
      }
      window.history.replaceState(window.history.state, '', url);
    };

    const showPhoto = (index: number) => {
      if (navigating || photos.length === 0) return;
      const wrappedIndex = (index + photos.length) % photos.length;
      const photo = photos[wrappedIndex];
      if (!photo) return;
      if (photo.path !== window.location.pathname) {
        const destination = new URL(photo.path, window.location.origin);
        destination.searchParams.set('foto', photo.id);
        navigating = true;
        // A real document navigation creates the history entry for the next spread.
        window.location.assign(destination);
        return;
      }
      const trigger = localTriggers.get(photo.id);
      const source = trigger?.querySelector<HTMLImageElement>('img');
      if (!trigger || !source || !image) return;

      currentIndex = wrappedIndex;
      image.src = source.currentSrc || source.src;
      image.srcset = source.srcset;
      image.sizes = '100vw';
      image.alt = source.alt;
      const hasMultiple = photos.length > 1;
      if (previous) previous.hidden = !hasMultiple;
      if (next) next.hidden = !hasMultiple;
      if (status) status.textContent = `Fotografía ${photo.position} de ${photos.length}`;
      updateUrl(trigger.dataset.photoId);
      return true;
    };

    const openViewer = (index: number, source?: HTMLAnchorElement) => {
      if (!showPhoto(index)) return;
      opener = source ?? null;
      if (!viewer.open) viewer.showModal();
      close?.focus();
    };

    const resetPointer = () => {
      activePointerId = null;
      pointerStartX = null;
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const index = photos.findIndex((photo) => photo.id === trigger.dataset.photoId);
        if (index < 0) return;
        event.preventDefault();
        openViewer(index, trigger);
      });
    });

    previous?.addEventListener('click', () => showPhoto(currentIndex - 1));
    next?.addEventListener('click', () => showPhoto(currentIndex + 1));

    viewer.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showPhoto(currentIndex - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        showPhoto(currentIndex + 1);
      }
    });

    image?.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary) return;
      activePointerId = event.pointerId;
      pointerStartX = event.clientX;
      image.setPointerCapture(event.pointerId);
    });

    image?.addEventListener('pointerup', (event) => {
      if (pointerStartX === null || activePointerId !== event.pointerId) return;
      const distance = event.clientX - pointerStartX;
      resetPointer();
      if (Math.abs(distance) < 60) return;
      showPhoto(currentIndex + (distance < 0 ? 1 : -1));
    });

    image?.addEventListener('pointercancel', (event) => {
      if (activePointerId === event.pointerId) resetPointer();
    });

    viewer.addEventListener('close', () => {
      resetPointer();
      if (navigating) return;
      updateUrl();
      opener?.focus();
      opener = null;
    });

    // A restored document from bfcache must be able to cross a spread again.
    window.addEventListener('pageshow', () => { navigating = false; });

    const requestedPhoto = new URL(window.location.href).searchParams.get('foto');
    if (requestedPhoto) {
      const requestedIndex = photos.findIndex((photo) => photo.id === requestedPhoto);
      if (requestedIndex >= 0) openViewer(requestedIndex, localTriggers.get(requestedPhoto));
    }
  }
</script>
