---
import type { AlbumPage } from '../lib/navigation';

interface Props {
  pages: AlbumPage[];
  currentPath: string;
}

const { pages, currentPath } = Astro.props;
const currentIndex = pages.findIndex(({ href }) => href === currentPath);
const previous = currentIndex > 0 ? pages[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < pages.length - 1 ? pages[currentIndex + 1] : undefined;

const closesFrontCover = currentPath === '/sobre-mi/' && previous?.href === '/';
const previousAria =
  currentPath === '/contraportada/' ? 'Reabrir álbum' :
  closesFrontCover ? 'Cerrar álbum' :
  previous ? `Página anterior: ${previous.label}` : '';
const nextAria =
  currentPath === '/' ? 'Abrir el álbum' :
  currentPath === '/contacto/' && next?.href === '/contraportada/' ? 'Cerrar álbum' :
  next ? `Página siguiente: ${next.label}` : '';

const previousKicker =
  currentPath === '/contraportada/' ? 'Reabrir álbum' :
  closesFrontCover ? 'Cerrar álbum' :
  'Página anterior';
const nextKicker =
  currentPath === '/' ? 'Abrir álbum' :
  currentPath === '/contacto/' && next?.href === '/contraportada/' ? 'Cerrar álbum' :
  'Página siguiente';
---

{(previous || next) && (
  <nav class="page-navigation" aria-label="Recorrido entre páginas del álbum" data-page-navigation>
    {previous ? (
      <a
        class="page-navigation-control page-navigation-previous"
        href={previous.href}
        rel="prev"
        aria-label={previousAria}
        data-page-direction="previous"
        data-page-destination={previous.label}
      >
        <span class="page-navigation-arrow" aria-hidden="true">←</span>
        <span class="page-navigation-copy">
          <span class="page-navigation-kicker">{previousKicker}</span>
          <span>{previous.label}</span>
        </span>
      </a>
    ) : <span class="page-navigation-spacer" aria-hidden="true"></span>}

    {next ? (
      <a
        class="page-navigation-control page-navigation-next"
        href={next.href}
        rel="next"
        aria-label={nextAria}
        data-page-direction="next"
        data-page-destination={next.label}
      >
        <span class="page-navigation-copy">
          <span class="page-navigation-kicker">{nextKicker}</span>
          <span>{next.label}</span>
        </span>
        <span class="page-navigation-arrow" aria-hidden="true">→</span>
      </a>
    ) : <span class="page-navigation-spacer" aria-hidden="true"></span>}
  </nav>
)}

<script>
  import { PageFlip } from 'page-flip';

  type TurnDirection = 'previous' | 'next';
  type CoverMode = 'open-front' | 'close-front' | 'close-back' | 'open-back';

  interface FlexibleRenderer {
    flip: PageFlip;
    host: HTMLElement;
    link: HTMLAnchorElement;
    direction: TurnDirection;
    started: boolean;
    settling: boolean;
    lastPoint: { x: number; y: number } | null;
  }

  interface CoverScene {
    flip: PageFlip;
    host: HTMLElement;
    mode: CoverMode;
    link: HTMLAnchorElement;
    direction: TurnDirection;
    startPage: number;
    endPage: number;
    pageWidth: number;
    started: boolean;
    settling: boolean;
    lastPoint: { x: number; y: number } | null;
  }

  const focusKey = 'album-page-navigation-focus';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const preparedRenderers = new WeakMap<HTMLAnchorElement, Promise<FlexibleRenderer | null>>();
  const preparedCoverScenes = new WeakMap<HTMLAnchorElement, Promise<CoverScene | null>>();

  const focusDestination = () => {
    const focusOrigin = sessionStorage.getItem(focusKey);
    if (!focusOrigin) return;

    sessionStorage.removeItem(focusKey);
    const main = document.querySelector<HTMLElement>('#contenido');
    if (!main) return;

    main.dataset.pageFocusOrigin = focusOrigin;
    main.focus({ preventScroll: true });
    main.addEventListener('blur', () => {
      delete main.dataset.pageFocusOrigin;
    }, { once: true });
  };

  const getSpread = () => document.querySelector<HTMLElement>('[data-album-spread]');
  const getStage = () => document.querySelector<HTMLElement>('.album-stage');
  const getObject = () => document.querySelector<HTMLElement>('[data-album-object]');
  const getNavigation = () => document.querySelector<HTMLElement>('[data-page-navigation]');

  const physicalModeAvailable = () => {
    if (reducedMotion.matches) return false;
    const navigation = getNavigation();
    return navigation ? getComputedStyle(navigation).position === 'absolute' : false;
  };

  const getActivePage = (direction: TurnDirection) => {
    const spread = getSpread();
    if (!spread) return null;

    return spread.querySelector<HTMLElement>(
      direction === 'next'
        ? ':scope > .album-page-right'
        : ':scope > .album-page-left',
    );
  };

  const physicalTurnAvailable = () => {
    if (!physicalModeAvailable()) return false;
    const spread = getSpread();
    const page = spread?.querySelector<HTMLElement>(':scope > .album-page');
    if (!spread || !page) return false;

    const spreadWidth = spread.getBoundingClientRect().width;
    const pageWidth = page.getBoundingClientRect().width;
    return spreadWidth > 0 && pageWidth > 0 && pageWidth < spreadWidth * 0.75;
  };

  const sanitizeVisualClone = (element: HTMLElement) => {
    element.removeAttribute('id');
    element.querySelectorAll<HTMLElement>('[id]').forEach((node) => node.removeAttribute('id'));
    element.querySelectorAll<HTMLElement>('a, button, input, select, textarea, [tabindex]').forEach(
      (node) => node.setAttribute('tabindex', '-1'),
    );
    element.querySelectorAll('dialog').forEach((dialog) => dialog.remove());
    element.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
      image.loading = 'eager';
      image.decoding = 'async';
    });
    return element;
  };

  const waitForVisualAssets = async (root: HTMLElement) => {
    const images = Array.from(root.querySelectorAll<HTMLImageElement>('img'));
    await Promise.allSettled(
      images.map(async (image) => {
        if (image.complete && image.naturalWidth > 0) return;
        await image.decode();
      }),
    );

    if ('fonts' in document) await document.fonts.ready;

    await new Promise<void>((resolve) => {
      requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
    });
  };

  const getViewContext = (source: HTMLElement) => {
    const spread = source.closest<HTMLElement>('[data-album-spread]');
    return ['about-view', 'contact-view', 'portfolio-index', 'category-view']
      .filter((className) => spread?.classList.contains(className));
  };

  const createCurlPage = (source: HTMLElement, label: string) => {
    const wrapper = document.createElement('div');
    wrapper.classList.add('album-curl-page', ...getViewContext(source));
    wrapper.dataset.curlPageWrapper = label;
    wrapper.setAttribute('aria-hidden', 'true');
    wrapper.setAttribute('inert', '');

    const surface = sanitizeVisualClone(source.cloneNode(true) as HTMLElement);
    surface.dataset.curlPage = label;
    wrapper.append(surface);
    return wrapper;
  };

  const createCoverSpreadPage = (source: HTMLElement, label: string) => {
    const wrapper = document.createElement('div');
    wrapper.classList.add('album-cover-page', ...getViewContext(source));
    wrapper.dataset.coverPageWrapper = label;
    wrapper.setAttribute('aria-hidden', 'true');
    wrapper.setAttribute('inert', '');

    const surface = sanitizeVisualClone(source.cloneNode(true) as HTMLElement);
    surface.dataset.coverPage = label;
    wrapper.append(surface);
    return wrapper;
  };

  const createHardCoverPage = (source: HTMLElement, label: string) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'album-cover-page album-cover-hard-page';
    wrapper.dataset.coverPageWrapper = label;
    wrapper.dataset.density = 'hard';
    wrapper.setAttribute('aria-hidden', 'true');
    wrapper.setAttribute('inert', '');

    const surface = sanitizeVisualClone(source.cloneNode(true) as HTMLElement);
    surface.dataset.coverPage = label;
    wrapper.append(surface);
    return wrapper;
  };

  const createCoverBlankPage = (label: string) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'album-cover-page album-cover-blank-page';
    wrapper.dataset.coverPageWrapper = label;
    wrapper.dataset.density = 'hard';
    wrapper.setAttribute('aria-hidden', 'true');
    wrapper.setAttribute('inert', '');
    return wrapper;
  };

  const prepareFlexibleRenderer = (
    link: HTMLAnchorElement,
    direction: TurnDirection,
  ): Promise<FlexibleRenderer | null> => {
    const cached = preparedRenderers.get(link);
    if (cached) return cached;

    const task = (async () => {
      if (!physicalTurnAvailable()) return null;

      const spread = getSpread();
      const currentLeft = spread?.querySelector<HTMLElement>(':scope > .album-page-left');
      const currentRight = spread?.querySelector<HTMLElement>(':scope > .album-page-right');
      if (!spread || !currentLeft || !currentRight) return null;

      try {
        const response = await fetch(link.href, {
          credentials: 'same-origin',
          headers: { 'X-Album-Turn-Preview': '1' },
        });
        if (!response.ok) return null;

        const html = await response.text();
        const parsed = new DOMParser().parseFromString(html, 'text/html');
        const destinationSpread = parsed.querySelector<HTMLElement>('[data-album-spread]');
        const destinationLeft =
          destinationSpread?.querySelector<HTMLElement>(':scope > .album-page-left');
        const destinationRight =
          destinationSpread?.querySelector<HTMLElement>(':scope > .album-page-right');
        if (!destinationSpread || !destinationLeft || !destinationRight) return null;

        const pageBox = currentLeft.getBoundingClientRect();
        if (pageBox.width <= 0 || pageBox.height <= 0) return null;

        const host = document.createElement('div');
        host.className = 'album-curl-renderer';
        host.dataset.curlRenderer = direction;
        host.setAttribute('aria-hidden', 'true');
        host.setAttribute('inert', '');

        const currentPages = [
          createCurlPage(currentLeft, 'current-left'),
          createCurlPage(currentRight, 'current-right'),
        ];
        const destinationPages = [
          createCurlPage(destinationLeft, 'destination-left'),
          createCurlPage(destinationRight, 'destination-right'),
        ];
        const pages =
          direction === 'next'
            ? [...currentPages, ...destinationPages]
            : [...destinationPages, ...currentPages];

        host.append(...pages);
        spread.prepend(host);

        const flip = new PageFlip(host, {
          width: Math.round(pageBox.width),
          height: Math.round(pageBox.height),
          size: 'fixed',
          startPage: direction === 'next' ? 0 : 2,
          drawShadow: true,
          flippingTime: 360,
          usePortrait: false,
          startZIndex: 20,
          autoSize: false,
          maxShadowOpacity: 0.42,
          showCover: false,
          mobileScrollSupport: true,
          clickEventForward: false,
          useMouseEvents: false,
          showPageCorners: false,
          disableFlipByClick: true,
        });

        flip.loadFromHTML(pages);
        await waitForVisualAssets(host);

        const renderer: FlexibleRenderer = {
          flip,
          host,
          link,
          direction,
          started: false,
          settling: false,
          lastPoint: null,
        };
        host.dataset.curlReady = 'true';
        return renderer;
      } catch {
        preparedRenderers.delete(link);
        return null;
      }
    })();

    preparedRenderers.set(link, task);
    return task;
  };

  const rendererPoint = (
    renderer: FlexibleRenderer,
    clientX: number,
    clientY: number,
  ) => {
    const dist = renderer.flip.getUI().getDistElement();
    const rect = dist.getBoundingClientRect();

    return {
      x: Math.max(1, Math.min(clientX - rect.left, rect.width - 1)),
      y: Math.max(1, Math.min(clientY - rect.top, rect.height - 1)),
    };
  };

  const beginFlexibleTurn = (
    renderer: FlexibleRenderer,
    startClientX: number,
    startClientY: number,
    currentClientX: number,
    currentClientY: number,
  ) => {
    if (renderer.started || renderer.settling) return;

    const spread = getSpread();
    if (!spread) return;

    spread.classList.add('is-flex-turning');
    spread.dataset.turnDirection = renderer.direction;
    renderer.host.dataset.curlActive = 'true';

    const start = rendererPoint(renderer, startClientX, startClientY);
    const current = rendererPoint(renderer, currentClientX, currentClientY);
    renderer.flip.startUserTouch(start);
    renderer.flip.userMove(current, false);
    renderer.lastPoint = current;
    renderer.started = true;
    document.documentElement.dataset.albumCurlActive = renderer.direction;
  };

  const moveFlexibleTurn = (
    renderer: FlexibleRenderer,
    clientX: number,
    clientY: number,
  ) => {
    if (!renderer.started || renderer.settling) return;

    const point = rendererPoint(renderer, clientX, clientY);
    renderer.flip.userMove(point, false);
    renderer.lastPoint = point;
    renderer.host.style.setProperty('--curl-pointer-x', String(point.x));
    renderer.host.style.setProperty('--curl-pointer-y', String(point.y));
  };

  const destroyRenderer = (renderer: FlexibleRenderer) => {
    const spread = getSpread();
    spread?.classList.remove('is-flex-turning');
    if (spread) {
      delete spread.dataset.turnDirection;
      delete spread.dataset.turnCommitted;
    }

    delete document.documentElement.dataset.albumCurlActive;
    preparedRenderers.delete(renderer.link);

    try {
      renderer.flip.destroy();
    } catch {
      renderer.host.remove();
    }
  };

  const animateRendererTo = async (
    renderer: FlexibleRenderer,
    target: { x: number; y: number },
    duration: number,
  ) => {
    const start = renderer.lastPoint ?? target;
    const startedAt = performance.now();

    await new Promise<void>((resolve) => {
      const frame = (now: number) => {
        const elapsed = Math.min(1, (now - startedAt) / Math.max(duration, 1));
        const eased = 1 - Math.pow(1 - elapsed, 3);
        const point = {
          x: start.x + (target.x - start.x) * eased,
          y: start.y + (target.y - start.y) * eased,
        };

        renderer.flip.userMove(point, false);
        renderer.lastPoint = point;

        if (elapsed < 1) requestAnimationFrame(frame);
        else resolve();
      };

      requestAnimationFrame(frame);
    });
  };

  const settleFlexibleTurn = async (
    renderer: FlexibleRenderer,
    progress: number,
    commit: boolean,
  ) => {
    if (!renderer.started || renderer.settling) return;
    renderer.settling = true;

    const dist = renderer.flip.getUI().getDistElement();
    const rect = dist.getBoundingClientRect();
    const clamped = Math.max(0, Math.min(progress, 1));
    const target = commit
      ? {
          x: renderer.direction === 'next' ? 1 : rect.width - 1,
          y: rect.height - 1,
        }
      : {
          x: renderer.direction === 'next' ? rect.width - 1 : 1,
          y: rect.height - 1,
        };
    const duration = commit
      ? Math.round(180 + (1 - clamped) * 240)
      : Math.round(160 + clamped * 120);

    await animateRendererTo(renderer, target, duration);

    if (!commit) {
      destroyRenderer(renderer);
      return;
    }

    const spread = getSpread();
    spread?.setAttribute('data-turn-committed', 'true');
    renderer.host.dataset.curlSettled = 'true';
    renderer.flip.turnToPage(renderer.direction === 'next' ? 2 : 0);
    sessionStorage.setItem(focusKey, 'pointer');
    document.documentElement.dataset.albumTurnNavigation = 'committed';

    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    window.location.assign(renderer.link.href);
  };

  const getCoverMode = (link: HTMLAnchorElement): CoverMode | null => {
    const path = window.location.pathname;
    const destination = new URL(link.href).pathname;

    if (path === '/' && destination === '/sobre-mi/') return 'open-front';
    if (path === '/sobre-mi/' && destination === '/') return 'close-front';
    if (path === '/contacto/' && destination === '/contraportada/') return 'close-back';
    if (path === '/contraportada/' && destination === '/contacto/') return 'open-back';
    return null;
  };

  const coverDirection = (mode: CoverMode): TurnDirection =>
    mode === 'open-front' || mode === 'close-back' ? 'next' : 'previous';

  const prepareCoverScene = (link: HTMLAnchorElement): Promise<CoverScene | null> => {
    const cached = preparedCoverScenes.get(link);
    if (cached) return cached;

    const task = (async () => {
      const mode = getCoverMode(link);
      const stage = getStage();
      const object = getObject();
      if (!mode || !stage || !object || !physicalModeAvailable()) return null;

      const currentSpread = object.querySelector<HTMLElement>('[data-album-spread]');
      const currentCover = object.querySelector<HTMLElement>('[data-album-cover]');

      try {
        const response = await fetch(link.href, {
          credentials: 'same-origin',
          headers: { 'X-Album-Cover-Preview': '1' },
        });
        if (!response.ok) return null;

        const html = await response.text();
        const parsed = new DOMParser().parseFromString(html, 'text/html');
        const destinationSpread = parsed.querySelector<HTMLElement>('[data-album-spread]');
        const destinationCover = parsed.querySelector<HTMLElement>('[data-album-cover]');

        const opening = mode === 'open-front' || mode === 'open-back';
        const spread = opening ? destinationSpread : currentSpread;
        const cover = opening ? currentCover : destinationCover;
        const left = spread?.querySelector<HTMLElement>(':scope > .album-page-left');
        const right = spread?.querySelector<HTMLElement>(':scope > .album-page-right');
        if (!cover || !left || !right) return null;

        const stageBox = stage.getBoundingClientRect();
        const referenceHeight =
          currentSpread?.getBoundingClientRect().height ??
          currentCover?.getBoundingClientRect().height ??
          stageBox.height;
        const pageWidth = stageBox.width / 2;
        if (pageWidth <= 0 || referenceHeight <= 0) return null;

        const host = document.createElement('div');
        host.className = 'album-cover-curl-renderer';
        host.dataset.coverTurn = mode;
        host.dataset.coverDirection = coverDirection(mode);
        host.setAttribute('aria-hidden', 'true');
        host.setAttribute('inert', '');

        let pages: HTMLElement[];
        let startPage: number;
        let endPage: number;

        if (mode === 'open-front' || mode === 'close-front') {
          pages = [
            createHardCoverPage(cover, 'front-cover'),
            createCoverSpreadPage(left, 'spread-left'),
            createCoverSpreadPage(right, 'spread-right'),
            createCoverBlankPage('back-placeholder'),
          ];
          startPage = mode === 'open-front' ? 0 : 1;
          endPage = mode === 'open-front' ? 1 : 0;
        } else {
          pages = [
            createCoverBlankPage('front-placeholder'),
            createCoverSpreadPage(left, 'spread-left'),
            createCoverSpreadPage(right, 'spread-right'),
            createHardCoverPage(cover, 'back-cover'),
          ];
          startPage = mode === 'close-back' ? 1 : 3;
          endPage = mode === 'close-back' ? 3 : 1;
        }

        host.append(...pages);
        stage.append(host);

        const flip = new PageFlip(host, {
          width: Math.round(pageWidth),
          height: Math.round(referenceHeight),
          size: 'fixed',
          startPage,
          drawShadow: true,
          flippingTime: 420,
          usePortrait: false,
          startZIndex: 24,
          autoSize: false,
          maxShadowOpacity: 0.48,
          showCover: true,
          mobileScrollSupport: true,
          clickEventForward: false,
          useMouseEvents: false,
          showPageCorners: false,
          disableFlipByClick: true,
        });

        flip.loadFromHTML(pages);
        flip.turnToPage(startPage);
        await waitForVisualAssets(host);

        const scene: CoverScene = {
          flip,
          host,
          mode,
          link,
          direction: coverDirection(mode),
          startPage,
          endPage,
          pageWidth,
          started: false,
          settling: false,
          lastPoint: null,
        };

        host.dataset.coverReady = 'true';
        return scene;
      } catch {
        preparedCoverScenes.delete(link);
        return null;
      }
    })();

    preparedCoverScenes.set(link, task);
    return task;
  };

  const coverRendererPoint = (
    scene: CoverScene,
    clientX: number,
    clientY: number,
  ) => {
    const dist = scene.flip.getUI().getDistElement();
    const rect = dist.getBoundingClientRect();

    return {
      x: Math.max(1, Math.min(clientX - rect.left, rect.width - 1)),
      y: Math.max(1, Math.min(clientY - rect.top, rect.height - 1)),
    };
  };

  const beginCoverTurn = (
    scene: CoverScene,
    startClientX: number,
    startClientY: number,
    currentClientX: number,
    currentClientY: number,
  ) => {
    if (scene.started || scene.settling) return;

    const stage = getStage();
    if (!stage) return;

    stage.classList.add('is-cover-turning');
    scene.host.classList.add('is-active');
    scene.host.dataset.coverActive = 'true';

    const start = coverRendererPoint(scene, startClientX, startClientY);
    const current = coverRendererPoint(scene, currentClientX, currentClientY);
    scene.flip.startUserTouch(start);
    scene.flip.userMove(current, false);
    scene.lastPoint = current;
    scene.started = true;
    document.documentElement.dataset.albumCoverActive = scene.mode;
  };

  const moveCoverTurn = (
    scene: CoverScene,
    clientX: number,
    clientY: number,
  ) => {
    if (!scene.started || scene.settling) return;

    const point = coverRendererPoint(scene, clientX, clientY);
    scene.flip.userMove(point, false);
    scene.lastPoint = point;
  };

  const destroyCoverScene = (scene: CoverScene) => {
    getStage()?.classList.remove('is-cover-turning');
    delete document.documentElement.dataset.albumCoverActive;
    preparedCoverScenes.delete(scene.link);

    try {
      scene.flip.destroy();
    } catch {
      scene.host.remove();
    }
  };

  const animateCoverTo = async (
    scene: CoverScene,
    target: { x: number; y: number },
    duration: number,
  ) => {
    const start = scene.lastPoint ?? target;
    const startedAt = performance.now();

    await new Promise<void>((resolve) => {
      const frame = (now: number) => {
        const elapsed = Math.min(1, (now - startedAt) / Math.max(duration, 1));
        const eased = 1 - Math.pow(1 - elapsed, 3);
        const point = {
          x: start.x + (target.x - start.x) * eased,
          y: start.y + (target.y - start.y) * eased,
        };

        scene.flip.userMove(point, false);
        scene.lastPoint = point;

        if (elapsed < 1) requestAnimationFrame(frame);
        else resolve();
      };

      requestAnimationFrame(frame);
    });
  };

  const startAutomaticCoverTurn = (scene: CoverScene) => {
    const dist = scene.flip.getUI().getDistElement();
    const rect = dist.getBoundingClientRect();
    const startX = scene.direction === 'next' ? rect.right - 10 : rect.left + 10;
    const startY = rect.bottom - 10;
    const currentX = scene.direction === 'next' ? startX - 12 : startX + 12;
    beginCoverTurn(scene, startX, startY, currentX, startY - 2);
  };

  const settleCoverTurn = async (
    scene: CoverScene,
    progress: number,
    commit: boolean,
    origin: 'pointer' | 'keyboard' = 'pointer',
  ) => {
    if (!scene.started || scene.settling) return;
    scene.settling = true;

    const dist = scene.flip.getUI().getDistElement();
    const rect = dist.getBoundingClientRect();
    const clamped = Math.max(0, Math.min(progress, 1));
    const target = commit
      ? {
          x: scene.direction === 'next' ? 1 : rect.width - 1,
          y: rect.height - 1,
        }
      : {
          x: scene.direction === 'next' ? rect.width - 1 : 1,
          y: rect.height - 1,
        };
    const duration = commit
      ? Math.round(190 + (1 - clamped) * 250)
      : Math.round(170 + clamped * 140);

    await animateCoverTo(scene, target, duration);

    if (!commit) {
      destroyCoverScene(scene);
      return;
    }

    scene.flip.turnToPage(scene.endPage);
    scene.host.dataset.coverSettled = 'true';
    sessionStorage.setItem(focusKey, origin);
    document.documentElement.dataset.albumTurnNavigation = 'committed';

    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
    window.location.assign(scene.link.href);
  };

  const navigateDirect = (
    link: HTMLAnchorElement,
    origin: 'keyboard' | 'pointer',
  ) => {
    sessionStorage.setItem(focusKey, origin);
    window.location.assign(link.href);
  };

  const enableFrameHandoff = () => {
    if (reducedMotion.matches) return;

    const style = document.createElement('style');
    style.dataset.albumFrameHandoff = '';
    style.textContent = `
      @view-transition { navigation: auto; }
      ::view-transition-group(root),
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none !important;
        mix-blend-mode: normal;
      }
    `;
    document.head.append(style);
  };

  focusDestination();
  enableFrameHandoff();

  document.querySelectorAll<HTMLAnchorElement>('[data-page-navigation] a').forEach((link) => {
    const direction: TurnDirection =
      link.dataset.pageDirection === 'previous' ? 'previous' : 'next';
    let pointerId: number | null = null;
    let startX = 0;
    let startY = 0;
    let lastX = 0;
    let lastY = 0;
    let dragging = false;
    let suppressClick = false;
    let activeRenderer: FlexibleRenderer | null = null;
    let activeCover: CoverScene | null = null;

    const warmInteraction = () => {
      if (!physicalModeAvailable()) return;
      const coverMode = getCoverMode(link);

      if (coverMode) {
        void prepareCoverScene(link).then((scene) => {
          activeCover = scene;
          if (!scene || pointerId === null || !dragging) return;
          beginCoverTurn(scene, startX, startY, lastX, lastY);
        });
        return;
      }

      void prepareFlexibleRenderer(link, direction).then((renderer) => {
        activeRenderer = renderer;
        if (!renderer || pointerId === null || !dragging) return;
        beginFlexibleTurn(renderer, startX, startY, lastX, lastY);
      });
    };

    link.draggable = false;
    link.addEventListener('pointerenter', warmInteraction, { once: true });
    link.addEventListener('focus', warmInteraction, { once: true });

    link.addEventListener('click', (event) => {
      if (suppressClick) {
        event.preventDefault();
        suppressClick = false;
        return;
      }

      const coverMode = getCoverMode(link);
      if (!coverMode || !physicalModeAvailable()) {
        sessionStorage.setItem(focusKey, event.detail === 0 ? 'keyboard' : 'pointer');
        return;
      }

      event.preventDefault();
      const origin = event.detail === 0 ? 'keyboard' : 'pointer';
      void prepareCoverScene(link).then((scene) => {
        if (!scene) {
          navigateDirect(link, origin);
          return;
        }
        startAutomaticCoverTurn(scene);
        void settleCoverTurn(scene, 0, true, origin);
      });
    });

    link.addEventListener('keydown', (event) => {
      if (event.key !== ' ' || event.repeat) return;
      event.preventDefault();
      link.click();
    });

    link.addEventListener('pointerdown', (event) => {
      if (!physicalModeAvailable() || !event.isPrimary || event.button !== 0) return;

      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      lastX = event.clientX;
      lastY = event.clientY;
      dragging = false;
      suppressClick = false;
      warmInteraction();
    });

    document.addEventListener('pointermove', (event) => {
      if (pointerId !== event.pointerId) return;

      lastX = event.clientX;
      lastY = event.clientY;
      const rawDistance = event.clientX - startX;
      if (!dragging && Math.hypot(rawDistance, event.clientY - startY) < 8) return;

      dragging = true;
      event.preventDefault();

      const coverMode = getCoverMode(link);
      if (coverMode) {
        if (!activeCover) return;
        if (!activeCover.started) {
          beginCoverTurn(activeCover, startX, startY, lastX, lastY);
        } else {
          moveCoverTurn(activeCover, lastX, lastY);
        }
        return;
      }

      if (!activeRenderer) return;
      if (!activeRenderer.started) {
        beginFlexibleTurn(activeRenderer, startX, startY, lastX, lastY);
      } else {
        moveFlexibleTurn(activeRenderer, lastX, lastY);
      }
    });

    document.addEventListener('pointerup', (event) => {
      if (pointerId !== event.pointerId) return;

      const rawDistance = event.clientX - startX;
      const coverMode = getCoverMode(link);
      const pageWidth = coverMode
        ? activeCover?.pageWidth ?? (getStage()?.getBoundingClientRect().width ?? 2) / 2
        : getActivePage(direction)?.getBoundingClientRect().width ?? 1;
      const distance = direction === 'next' ? -rawDistance : rawDistance;
      const progress = Math.max(0, Math.min(distance / pageWidth, 1));
      pointerId = null;

      if (!dragging) return;

      suppressClick = true;
      dragging = false;
      event.preventDefault();

      if (coverMode) {
        if (!activeCover) {
          if (progress >= 0.4) navigateDirect(link, 'pointer');
          return;
        }
        void settleCoverTurn(activeCover, progress, progress >= 0.4);
        return;
      }

      if (!activeRenderer?.started) {
        if (progress >= 0.4) navigateDirect(link, 'pointer');
        return;
      }

      void settleFlexibleTurn(activeRenderer, progress, progress >= 0.4);
    });

    document.addEventListener('pointercancel', (event) => {
      if (pointerId !== event.pointerId) return;

      pointerId = null;
      if (!dragging) return;

      suppressClick = true;
      dragging = false;
      const coverMode = getCoverMode(link);
      if (coverMode && activeCover?.started) {
        const pageWidth = activeCover.pageWidth;
        const raw = lastX - startX;
        const distance = direction === 'next' ? -raw : raw;
        const progress = Math.max(0, Math.min(distance / pageWidth, 1));
        void settleCoverTurn(activeCover, progress, false);
      } else if (activeRenderer?.started) {
        const pageWidth = getActivePage(direction)?.getBoundingClientRect().width ?? 1;
        const distance = direction === 'next' ? startX - lastX : lastX - startX;
        const progress = Math.max(0, Math.min(distance / pageWidth, 1));
        void settleFlexibleTurn(activeRenderer, progress, false);
      }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-cover-open-action]').forEach((link) => {
    const matchingControl = document.querySelector<HTMLAnchorElement>(
      `[data-page-navigation] a[href="${link.getAttribute('href')}"]`,
    );
    if (!matchingControl) return;

    link.addEventListener('pointerenter', () => {
      if (physicalModeAvailable()) void prepareCoverScene(matchingControl);
    }, { once: true });

    link.addEventListener('focus', () => {
      if (physicalModeAvailable()) void prepareCoverScene(matchingControl);
    }, { once: true });

    link.addEventListener('click', (event) => {
      if (!physicalModeAvailable()) {
        sessionStorage.setItem(focusKey, event.detail === 0 ? 'keyboard' : 'pointer');
        return;
      }

      event.preventDefault();
      const origin = event.detail === 0 ? 'keyboard' : 'pointer';
      void prepareCoverScene(matchingControl).then((scene) => {
        if (!scene) {
          navigateDirect(matchingControl, origin);
          return;
        }
        startAutomaticCoverTurn(scene);
        void settleCoverTurn(scene, 0, true, origin);
      });
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    if (document.querySelector('dialog[open]')) return;

    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      (target instanceof HTMLElement && target.isContentEditable)
    ) return;

    const direction = event.key === 'ArrowLeft' ? 'previous' : 'next';
    const link = document.querySelector<HTMLAnchorElement>(
      `[data-page-navigation] a[data-page-direction="${direction}"]`,
    );
    if (!link) return;

    event.preventDefault();
    if (getCoverMode(link) && physicalModeAvailable()) link.click();
    else navigateDirect(link, 'keyboard');
  });

  document.documentElement.dataset.pageNavigationReady = 'true';
</script>
