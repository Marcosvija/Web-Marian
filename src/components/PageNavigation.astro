---
import type { AlbumPage } from '../lib/navigation';

interface Props {
  pages: AlbumPage[];
  currentPath: string;
}

const { pages, currentPath } = Astro.props;
const currentIndex = pages.findIndex(({ href }) => href === currentPath);
const previous = currentIndex > 0 ? pages[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < pages.length - 1 ? pages[currentIndex + 1] : undefined;
---

{(previous || next) && (
  <nav class="page-navigation" aria-label="Recorrido entre páginas del álbum" data-page-navigation>
    {previous ? (
      <a
        class="page-navigation-control page-navigation-previous"
        href={previous.href}
        rel="prev"
        aria-label={`Página anterior: ${previous.label}`}
        data-page-direction="previous"
        data-page-destination={previous.label}
      >
        <span class="page-navigation-arrow" aria-hidden="true">←</span>
        <span class="page-navigation-copy">
          <span class="page-navigation-kicker">Página anterior</span>
          <span>{previous.label}</span>
        </span>
      </a>
    ) : <span class="page-navigation-spacer" aria-hidden="true"></span>}

    {next ? (
      <a
        class="page-navigation-control page-navigation-next"
        href={next.href}
        rel="next"
        aria-label={`Página siguiente: ${next.label}`}
        data-page-direction="next"
        data-page-destination={next.label}
      >
        <span class="page-navigation-copy">
          <span class="page-navigation-kicker">Página siguiente</span>
          <span>{next.label}</span>
        </span>
        <span class="page-navigation-arrow" aria-hidden="true">→</span>
      </a>
    ) : <span class="page-navigation-spacer" aria-hidden="true"></span>}
  </nav>
)}

<script>
  type TurnDirection = 'previous' | 'next';

  interface PreparedScene {
    preview: HTMLElement;
    left: HTMLElement;
    right: HTMLElement;
  }

  const focusKey = 'album-page-navigation-focus';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const preparedScenes = new WeakMap<HTMLAnchorElement, Promise<PreparedScene | null>>();

  const focusDestination = () => {
    const focusOrigin = sessionStorage.getItem(focusKey);
    if (!focusOrigin) return;

    sessionStorage.removeItem(focusKey);
    const main = document.querySelector<HTMLElement>('#contenido');
    if (!main) return;

    main.dataset.pageFocusOrigin = focusOrigin;
    main.focus({ preventScroll: true });
    main.addEventListener('blur', () => {
      delete main.dataset.pageFocusOrigin;
    }, { once: true });
  };

  const getSpread = () => document.querySelector<HTMLElement>('[data-album-spread]');

  const getActivePage = (direction: TurnDirection) => {
    const spread = getSpread();
    if (!spread) return null;
    return spread.querySelector<HTMLElement>(
      direction === 'next' ? '.album-page-right' : '.album-page-left',
    );
  };

  const physicalTurnAvailable = () => {
    if (reducedMotion.matches) return false;
    const spread = getSpread();
    const page = spread?.querySelector<HTMLElement>('.album-page');
    if (!spread || !page) return false;

    const spreadWidth = spread.getBoundingClientRect().width;
    const pageWidth = page.getBoundingClientRect().width;
    return spreadWidth > 0 && pageWidth > 0 && pageWidth < spreadWidth * 0.75;
  };

  const sanitizeVisualClone = (element: HTMLElement) => {
    element.removeAttribute('id');
    element.querySelectorAll<HTMLElement>('[id]').forEach((node) => node.removeAttribute('id'));
    element.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
      image.loading = 'eager';
      image.decoding = 'async';
    });
    return element;
  };

  const prepareDestination = (
    link: HTMLAnchorElement,
    direction: TurnDirection,
  ): Promise<PreparedScene | null> => {
    const cached = preparedScenes.get(link);
    if (cached) return cached;

    const task = (async () => {
      try {
        const response = await fetch(link.href, {
          credentials: 'same-origin',
          headers: { 'X-Album-Turn-Preview': '1' },
        });
        if (!response.ok) return null;

        const html = await response.text();
        const parsed = new DOMParser().parseFromString(html, 'text/html');
        const destinationSpread = parsed.querySelector<HTMLElement>('[data-album-spread]');
        const sourceLeft = destinationSpread?.querySelector<HTMLElement>('.album-page-left');
        const sourceRight = destinationSpread?.querySelector<HTMLElement>('.album-page-right');
        const spread = getSpread();
        if (!destinationSpread || !sourceLeft || !sourceRight || !spread) return null;

        const preview = document.createElement('div');
        preview.className = 'album-turn-preview';
        preview.dataset.turnPreview = '';
        preview.dataset.turnPreviewDirection = direction;
        preview.setAttribute('aria-hidden', 'true');
        preview.setAttribute('inert', '');

        const left = sanitizeVisualClone(sourceLeft.cloneNode(true) as HTMLElement);
        const right = sanitizeVisualClone(sourceRight.cloneNode(true) as HTMLElement);
        left.dataset.turnPreviewPage = 'left';
        right.dataset.turnPreviewPage = 'right';
        preview.append(left, right);
        spread.prepend(preview);

        return { preview, left, right };
      } catch {
        return null;
      }
    })();

    preparedScenes.set(link, task);
    return task;
  };

  const createTurnFace = (
    side: 'left' | 'right',
    className: 'album-turn-front' | 'album-turn-back',
  ) => {
    const face = document.createElement('div');
    face.className = `album-turn-face ${className} album-turn-face-${side}`;
    return face;
  };

  const mountTurningFaces = (
    page: HTMLElement,
    direction: TurnDirection,
    scene: PreparedScene,
  ) => {
    if (page.querySelector(':scope > .album-turn-front')) return;

    const sourceSide = direction === 'next' ? 'right' : 'left';
    const destinationSide = direction === 'next' ? 'left' : 'right';
    const destinationPage = direction === 'next' ? scene.left : scene.right;
    const front = createTurnFace(sourceSide, 'album-turn-front');
    const back = createTurnFace(destinationSide, 'album-turn-back');

    while (page.firstChild) front.append(page.firstChild);
    Array.from(destinationPage.childNodes).forEach((node) => {
      back.append(node.cloneNode(true));
    });
    sanitizeVisualClone(back);

    back.setAttribute('aria-hidden', 'true');
    back.setAttribute('inert', '');
    page.append(front, back);
  };

  const restoreTurningPage = (page: HTMLElement) => {
    const front = page.querySelector<HTMLElement>(':scope > .album-turn-front');
    if (front) {
      const nodes = Array.from(front.childNodes);
      nodes.forEach((node) => page.insertBefore(node, front));
    }
    page.querySelector(':scope > .album-turn-front')?.remove();
    page.querySelector(':scope > .album-turn-back')?.remove();
    page.classList.remove('is-page-turning');
    page.style.removeProperty('transition');
    page.style.removeProperty('transform');
    delete page.dataset.turnProgress;
  };

  const deactivateScene = (scene: PreparedScene | null) => {
    scene?.preview.classList.remove('is-active');
  };

  const applyTurn = (
    link: HTMLAnchorElement,
    direction: TurnDirection,
    progress: number,
    scene: PreparedScene,
  ) => {
    const spread = getSpread();
    const page = getActivePage(direction);
    if (!spread || !page) return;

    const clamped = Math.max(0, Math.min(progress, 1));
    const angle = clamped * 180 * (direction === 'next' ? -1 : 1);

    mountTurningFaces(page, direction, scene);
    scene.preview.classList.add('is-active');
    spread.dataset.turnDirection = direction;
    spread.dataset.turnLabel = link.dataset.pageDestination ?? '';
    spread.style.setProperty('--turn-progress', String(clamped));
    page.dataset.turnProgress = String(clamped);
    page.classList.add('is-page-turning');
    page.style.transition = 'none';
    page.style.transform = `rotateY(${angle}deg)`;
  };

  const clearTurn = (
    direction: TurnDirection,
    scene: PreparedScene | null,
    progress: number,
  ) => {
    const spread = getSpread();
    const page = getActivePage(direction);
    if (!spread || !page) return;

    const duration = Math.round(160 + Math.max(0, Math.min(progress, 1)) * 120);
    page.style.transition = `transform ${duration}ms cubic-bezier(0.22, 0.61, 0.36, 1)`;
    page.style.transform = 'rotateY(0deg)';
    spread.style.setProperty('--turn-progress', '0');

    window.setTimeout(() => {
      restoreTurningPage(page);
      deactivateScene(scene);
      spread.style.removeProperty('--turn-progress');
      delete spread.dataset.turnDirection;
      delete spread.dataset.turnLabel;
    }, duration + 20);
  };

  const navigateDirect = (
    link: HTMLAnchorElement,
    origin: 'keyboard' | 'pointer',
  ) => {
    sessionStorage.setItem(focusKey, origin);
    window.location.assign(link.href);
  };

  const completeTurn = (
    link: HTMLAnchorElement,
    direction: TurnDirection,
    scene: PreparedScene | null,
    progress: number,
  ) => {
    const spread = getSpread();
    const page = getActivePage(direction);
    if (!spread || !page || !scene) {
      navigateDirect(link, 'pointer');
      return;
    }

    const clamped = Math.max(0, Math.min(progress, 1));
    const remaining = 1 - clamped;
    const duration = Math.round(180 + remaining * 240);
    const angle = direction === 'next' ? -180 : 180;

    scene.preview.classList.add('is-active');
    page.style.transition = `transform ${duration}ms cubic-bezier(0.32, 0.72, 0, 1)`;
    page.style.transform = `rotateY(${angle}deg)`;
    page.dataset.turnProgress = '1';
    spread.style.setProperty('--turn-progress', '1');
    spread.dataset.turnCommitted = 'true';
    sessionStorage.setItem(focusKey, 'pointer');

    window.setTimeout(() => {
      document.documentElement.dataset.albumTurnNavigation = 'committed';
      window.location.assign(link.href);
    }, duration);
  };

  focusDestination();

  document.querySelectorAll<HTMLAnchorElement>('[data-page-navigation] a').forEach((link) => {
    const direction: TurnDirection =
      link.dataset.pageDirection === 'previous' ? 'previous' : 'next';
    let pointerId: number | null = null;
    let startX = 0;
    let lastX = 0;
    let dragging = false;
    let suppressClick = false;
    let activeScene: PreparedScene | null = null;

    const warmDestination = () => {
      if (!physicalTurnAvailable()) return;
      void prepareDestination(link, direction).then((scene) => {
        activeScene = scene;
        if (pointerId === null || !dragging || !scene) return;

        const rawDistance = lastX - startX;
        const distance = direction === 'next' ? -rawDistance : rawDistance;
        const page = getActivePage(direction);
        const pageWidth = page?.getBoundingClientRect().width ?? 1;
        applyTurn(link, direction, Math.max(0, distance) / pageWidth, scene);
      });
    };

    link.draggable = false;
    link.addEventListener('pointerenter', warmDestination, { once: true });
    link.addEventListener('focus', warmDestination, { once: true });

    link.addEventListener('click', (event) => {
      if (suppressClick) {
        event.preventDefault();
        suppressClick = false;
        return;
      }
      sessionStorage.setItem(focusKey, event.detail === 0 ? 'keyboard' : 'pointer');
    });

    link.addEventListener('keydown', (event) => {
      if (event.key !== ' ' || event.repeat) return;
      event.preventDefault();
      navigateDirect(link, 'keyboard');
    });

    link.addEventListener('pointerdown', (event) => {
      if (!physicalTurnAvailable() || !event.isPrimary || event.button !== 0) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      lastX = event.clientX;
      dragging = false;
      suppressClick = false;
      warmDestination();
    });

    document.addEventListener('pointermove', (event) => {
      if (pointerId !== event.pointerId) return;
      lastX = event.clientX;

      const rawDistance = event.clientX - startX;
      const distance = direction === 'next' ? -rawDistance : rawDistance;
      if (!dragging && Math.abs(rawDistance) < 8) return;

      dragging = true;
      event.preventDefault();
      if (!activeScene) return;

      const page = getActivePage(direction);
      const pageWidth = page?.getBoundingClientRect().width ?? 1;
      applyTurn(link, direction, Math.max(0, distance) / pageWidth, activeScene);
    });

    document.addEventListener('pointerup', (event) => {
      if (pointerId !== event.pointerId) return;

      const rawDistance = event.clientX - startX;
      const distance = direction === 'next' ? -rawDistance : rawDistance;
      const page = getActivePage(direction);
      const pageWidth = page?.getBoundingClientRect().width ?? 1;
      const progress = Math.max(0, Math.min(distance / pageWidth, 1));
      pointerId = null;

      if (!dragging) return;

      suppressClick = true;
      dragging = false;
      event.preventDefault();

      if (progress >= 0.4) {
        completeTurn(link, direction, activeScene, progress);
      } else if (activeScene) {
        clearTurn(direction, activeScene, progress);
      }
    });

    document.addEventListener('pointercancel', (event) => {
      if (pointerId !== event.pointerId) return;
      pointerId = null;
      if (dragging) {
        suppressClick = true;
        dragging = false;
        clearTurn(direction, activeScene, Number(getActivePage(direction)?.dataset.turnProgress ?? 0));
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    if (document.querySelector('dialog[open]')) return;

    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      (target instanceof HTMLElement && target.isContentEditable)
    ) return;

    const direction = event.key === 'ArrowLeft' ? 'previous' : 'next';
    const link = document.querySelector<HTMLAnchorElement>(
      `[data-page-navigation] a[data-page-direction="${direction}"]`,
    );
    if (!link) return;

    event.preventDefault();
    navigateDirect(link, 'keyboard');
  });

  document.documentElement.dataset.pageNavigationReady = 'true';
</script>
