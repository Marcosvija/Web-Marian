---
import PortfolioIndexView from '../../components/PortfolioIndexView.astro';
import { getAlbumMap, getPortfolioEditorialMap } from '../../lib/navigation';
import AlbumLayout from '../../layouts/AlbumLayout.astro';

const albumMap = await getAlbumMap();
const editorialMap = getPortfolioEditorialMap(albumMap);
---

<AlbumLayout title="Portfolio — Marian">
  <PortfolioIndexView items={editorialMap} currentPath={Astro.url.pathname} />
</AlbumLayout>
