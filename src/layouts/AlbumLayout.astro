---
import BookmarkIndex from '../components/BookmarkIndex.astro';
import PageNavigation from '../components/PageNavigation.astro';
import { getAlbumMap } from '../lib/navigation';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
const albumMap = await getAlbumMap();
const currentPath = Astro.url.pathname;
const isFrontCover = currentPath === '/';
const isBackCover = currentPath === '/contraportada/';
const isClosedCover = isFrontCover || isBackCover;
---

<BaseLayout title={title} description={description}>
  <div class="site-shell">
    <main id="contenido" class="album-frame" tabindex="-1">
      <div class="album-stage">
        <div
          class:list={[
            'album-object',
            {
              'is-closed-cover': isClosedCover,
              'is-front-cover-object': isFrontCover,
              'is-back-cover-object': isBackCover,
            },
          ]}
          data-album-object
        >
          <header class="site-header">
            <a class="site-home" href="/" aria-label="Marian, inicio">
              <span aria-hidden="true">M</span>
              <span>Marian</span>
            </a>
          </header>

          <BookmarkIndex items={albumMap} currentPath={currentPath} />
          <slot />
          <PageNavigation pages={albumMap} currentPath={currentPath} />
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
