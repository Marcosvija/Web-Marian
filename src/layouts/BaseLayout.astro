---
import '../styles/global.css';
import '../styles/page-navigation.css';
import '../styles/album-spread.css';
import indexLayoutScript from '../scripts/album-index-layout.js?raw';

interface Props {
  title: string;
  description?: string | undefined;
}

const {
  title,
  description = 'Portfolio fotográfico de Marian.',
} = Astro.props;
---

<!doctype html>
<html lang="es" data-qa-canvas={import.meta.env.DEV ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline set:html={indexLayoutScript} />
    <script is:inline>
      // Opt in before the destination's first paint, without waiting for the
      // deferred navigation module. No-JS, reflow and reduced motion stay direct.
      (() => {
        const style = document.createElement('style');
        style.dataset.albumFrameHandoff = '';
        style.media = '(min-width: 59rem) and (min-height: 38rem) and (prefers-reduced-motion: no-preference)';
        style.textContent = `
          @view-transition { navigation: auto; }
          ::view-transition-group(root),
          ::view-transition-old(root),
          ::view-transition-new(root) {
            animation: none !important;
            mix-blend-mode: normal;
          }
        `;
        document.head.append(style);
        const acceptSkippedSnapshot = (event) => {
          // A browser can skip a snapshot; that never blocks the real route.
          void event.viewTransition?.ready.catch(() => {});
        };
        window.addEventListener('pageswap', acceptSkippedSnapshot);
        window.addEventListener('pagereveal', acceptSkippedSnapshot);
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
