{
  "name": "web-marian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "astro dev --force",
    "dev:test": "node ./scripts/astro-with-fixtures.mjs dev --force --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "astro build --force",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
